{
    "name": "fly-dbh-assets-server",
    "type": "module",
    "version": "0.0.1",
    "scripts": {
        "start": "node start.js",
        "start-server": "cross-env FLY_DBH_ASSETS_SERVER_PORT=8081 node main.js",
