    "dependencies": {
        "dayjs": "^1.11.19",
        "dotenv": "^17.2.3",
        "fs-extra": "^11.3.2",
        "glob": "^13.0.0",
        "koa": "^3.1.1",
        "koa-cash": "^5.0.0",
        "koa-convert": "^2.0.0",
        "koa-helmet": "^8.0.3",
        "koa-send": "^5.0.1",
        "lru-cache": "^11.2.4",
        "md5": "^2.3.0",
        "yargs": "^18.0.0"
    },
    "devDependencies": {
        "cross-env": "^10.1.0",
        "inquirer": "^13.1.0",
        "npm-run-script": "^0.0.4",
        "prettier": "^3.7.4"
    }
